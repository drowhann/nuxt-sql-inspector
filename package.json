{
  "name": "nuxt-sql-inspector",
  "version": "0.1.0",
  "description": "Dev-only Nuxt module that shows API requests and their PostgreSQL queries.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohan/sql-inspector.git"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "drizzle",
    "postgres",
    "sql",
    "inspector"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && sh -c 'cd playground && drizzle-kit push --force' && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^3.16.0"
  },
  "peerDependencies": {
    "nuxt": ">=3.16.0",
    "pg": ">=8",
    "postgres": ">=3"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^3.21.11",
    "@nuxt/test-utils": "^3.19.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.0",
    "nuxt": "^3.21.11",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.0"
  }
}
